@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_LayoutSplash.cshtml"; // loads your consolidated CSS
}

<section class="splash tavern d-flex align-items-center justify-content-center text-center">
    <!-- 3D Tavern background -->
    <canvas id="tavern3d-canvas" aria-hidden="true"></canvas>

    <!-- Parchment ledger (content) -->
    <div class="ledger p-4 p-md-5">
        <div class="brand mb-3">
            <div class="logo-circle mx-auto mb-3 d20-3d">
                <canvas id="d20-canvas" aria-label="Animated 3D d20"></canvas>
            </div>
            <h1 class="fw-bold mb-1 title-fantasy">MAGEHAND</h1>
@*             <p class="lead opacity-85 mb-0">Enter as guests. Sign in as heroes.</p> *@
            <p class="lead opacity-85 mb-0"><i>Roleplaying in the age of AI</i></p>
        </div>

        <!-- Simple actions; details live in modals -->
        <div class="mt-4 d-grid gap-2">
            <a href="#signinModal" class="btn btn-parchment btn-lg" data-bs-toggle="modal">
                <i class="bi bi-box-arrow-in-right me-2"></i> Sign in
            </a>
            <a href="#signupModal" class="btn btn-ale btn-lg" data-bs-toggle="modal">
                <i class="bi bi-person-plus me-2"></i> Create account
            </a>
        </div>

        <div class="mt-3 small parchment-links">
            By continuing you agree to our
            <a class="parchment-link text-decoration-underline" href="/home/privacy">Privacy Policy</a>.
        </div>
    </div>

    <!-- Overlay polish -->
    <div class="embers" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
</section>

<!-- ===================== Sign In Modal ===================== -->
<div class="modal fade" id="signinModal" tabindex="-1" aria-labelledby="signinTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="signinTitle">Welcome back</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                @if (TempData["LoginError"] is string loginErr && !string.IsNullOrWhiteSpace(loginErr))
                {
                    <div class="alert alert-danger mb-3">@loginErr</div>
                }
                @if (TempData["DevConfirmLink"] is string confirmUrl && !string.IsNullOrWhiteSpace(confirmUrl))
                {
                    <div class="alert alert-info d-flex align-items-center gap-2">
                        <i class="bi bi-bug"></i>
                        <div>
                            <strong>Dev only:</strong> Confirm now →
                            <a class="btn btn-sm btn-outline-primary ms-2" href="@confirmUrl">Confirm Email</a>
                        </div>
                    </div>
                }
                <div class="row g-4">
                    <!-- Email/Username + password -->
                    <div class="col-12 col-lg-6">
                        <h6 class="mb-3">Sign in</h6>
                        <form method="post" action="/auth/login">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="/Dashboard" />

                            <div class="mb-3">
                                <label class="form-label">Email or Username</label>
                                <input name="EmailOrUsername" type="text" class="form-control" placeholder="you@example.com or yourhandle" required />
                            </div>

                            <div class="mb-2">
                                <label class="form-label">Password</label>
                                <input name="Password" type="password" class="form-control" required />
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe" value="true">
                                    <label class="form-check-label" for="rememberMe">Remember me</label>
                                </div>
                                <a class="small" asp-area="Identity" asp-page="/Account/ForgotPassword">Forgot password?</a>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Sign in</button>
                        </form>
                    </div>

                    <!-- Providers -->
                    <div class="col-12 col-lg-6">
                        <h6 class="mb-3">Or continue with</h6>

                        <form method="post"
                              asp-area="Identity"
                              asp-page="/Account/ExternalLogin"
                              asp-route-returnUrl="/Dashboard"
                              class="mb-2">
                            <button type="submit" name="provider" value="Google" class="btn btn-ale w-100">
                                <i class="bi bi-google me-2"></i> Continue with Google
                            </button>
                        </form>

                        <a class="btn btn-guild w-100 mb-2" href="/auth/windows?returnUrl=/Dashboard">
                            <i class="bi bi-windows me-2"></i> Continue with Windows
                        </a>

                        <form method="post"
                              asp-area="Identity"
                              asp-page="/Account/ExternalLogin"
                              asp-route-returnUrl="/Dashboard">
                            <button type="submit" name="provider" value="GitHub" class="btn btn-dark w-100">
                                <i class="bi bi-github me-2"></i> Continue with GitHub
                            </button>
                        </form>

                        <p class="text-muted small mt-3">
                            New here?
                            <a href="#signupModal" data-bs-toggle="modal" data-bs-target="#signupModal" data-bs-dismiss="modal">Create an account</a>.
                        </p>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <span class="small">Need an account?</span>
                <a class="btn btn-outline-secondary ms-2" href="#signupModal" data-bs-toggle="modal" data-bs-target="#signupModal" data-bs-dismiss="modal">
                    Sign up
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ===================== Sign Up Modal ===================== -->
<div class="modal fade" id="signupModal" tabindex="-1" aria-labelledby="signupTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="signupTitle">Create your account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                @if (TempData["RegisterError"] is string regErr && !string.IsNullOrWhiteSpace(regErr))
                {
                    <div class="alert alert-danger mb-3">@regErr</div>
                }
                <div class="row g-4">
                    <!-- Email/password column -->
                    <div class="col-12 col-lg-6">
                        <h6 class="mb-3">Sign up with email</h6>
                        <form method="post" action="/auth/register">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="/Dashboard" />

                            <div class="mb-3">
                                <label class="form-label">Username</label>
                                <input name="UserName"
                                       type="text"
                                       class="form-control"
                                       placeholder="e.g. azog_the_sky"
                                       minlength="3"
                                       maxlength="20"
                                       pattern="^[a-zA-Z0-9_]{3,20}$"
                                       required />
                                <div class="form-text">3–20 letters, numbers, or underscores.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input name="Email" type="email" class="form-control" placeholder="you@example.com" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <input name="Password" type="password" class="form-control" minlength="6" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Confirm password</label>
                                <input name="ConfirmPassword" type="password" class="form-control" minlength="6" required />
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Create account</button>
                        </form>
                    </div>

                    <!-- Providers -->
                    <div class="col-12 col-lg-6">
                        <h6 class="mb-3">Or continue with</h6>

                        <form method="post"
                              asp-area="Identity"
                              asp-page="/Account/ExternalLogin"
                              asp-route-returnUrl="/Dashboard"
                              class="mb-2">
                            <button type="submit" name="provider" value="Google" class="btn btn-ale w-100">
                                <i class="bi bi-google me-2"></i> Continue with Google
                            </button>
                        </form>

                        <a class="btn btn-guild w-100 mb-2" href="/auth/windows?returnUrl=/Dashboard">
                            <i class="bi bi-windows me-2"></i> Continue with Windows
                        </a>

                        <form method="post"
                              asp-area="Identity"
                              asp-page="/Account/ExternalLogin"
                              asp-route-returnUrl="/Dashboard">
                            <button type="submit" name="provider" value="GitHub" class="btn btn-dark w-100">
                                <i class="bi bi-github me-2"></i> Continue with GitHub
                            </button>
                        </form>

                        <p class="text-muted small mt-3">
                            By continuing you agree to our
                            <a href="/home/privacy" class="text-decoration-underline">Privacy Policy</a>.
                        </p>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <span class="small">Already have an account?</span>
                <a class="btn btn-outline-secondary ms-2" href="#signinModal" data-bs-toggle="modal" data-bs-target="#signinModal" data-bs-dismiss="modal">
                    Sign in
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Three.js core (for the 3D tavern background) -->
    <script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>

    <!-- 3D Tavern scene (your new drop-in file) -->
    <script src="~/js/tavern3d.js" asp-append-version="true"></script>

    <!-- Your existing D20 script -->
    <script src="~/js/d20.js" asp-append-version="true"></script>

    <script>
        // Auto-open modal if TempData requested it
        (function () {
            const params = new URLSearchParams(window.location.search);
            const openLogin = params.get('showLogin') === 'true' || @((TempData["LoginError"] != null).ToString().ToLower());
            const openSignup = params.get('showRegister') === 'true' || @((TempData["RegisterError"] != null).ToString().ToLower());
            if (openLogin) new bootstrap.Modal(document.getElementById('signinModal')).show();
            else if (openSignup) new bootstrap.Modal(document.getElementById('signupModal')).show();
        })();
    </script>
}
